# Firecrawl
# AI BOX uses Firecrawl's official keyless API mode for the free 1,000-credit/month allowance.
FIRECRAWL_MODE=keyless
# Optional: configure a Firecrawl API key instead when higher limits are required.
# FIRECRAWL_API_KEY=your_firecrawl_api_key

# =================================================================================
# SANDBOX PROVIDER
# =================================================================================

# AI BOX default: local Docker sandbox. No Vercel or E2B credential is required.
SANDBOX_PROVIDER=local-docker

# AI BOX managed deployment builds sandbox/Dockerfile automatically and injects a
# commit-scoped LOCAL_SANDBOX_IMAGE tag. For local development, build it first:
# docker build -t open-lovable-sandbox:dev -f sandbox/Dockerfile sandbox
LOCAL_SANDBOX_IMAGE=open-lovable-sandbox:dev

# Optional local sandbox resource overrides
# LOCAL_SANDBOX_HOST=127.0.0.1
# LOCAL_SANDBOX_MEMORY=1536m
# LOCAL_SANDBOX_CPUS=2
# LOCAL_SANDBOX_PIDS=512

# Optional alternative: E2B
# SANDBOX_PROVIDER=e2b
# E2B_API_KEY=your_e2b_api_key

# Optional alternative: Vercel Sandbox
# SANDBOX_PROVIDER=vercel
# VERCEL_OIDC_TOKEN=your_vercel_oidc_token
# Or use all three PAT fields:
# VERCEL_TEAM_ID=team_xxxxxxxxx
# VERCEL_PROJECT_ID=prj_xxxxxxxxx
# VERCEL_TOKEN=vercel_xxxxxxxxxxxx

# =================================================================================
# AI PROVIDERS - Need at least one
# =================================================================================

# Vercel AI Gateway is optional and independent of the sandbox provider.
AI_GATEWAY_API_KEY=your_ai_gateway_api_key

# Or use one individual provider key.
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Optional Morph Fast Apply
MORPH_API_KEY=your_fast_apply_key
